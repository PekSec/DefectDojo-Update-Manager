# Install on the host reverse proxy only after setting the real DNS name and certificates.
server {
    listen 443 ssl;
    server_name dojo.example.internal;
    ssl_certificate /etc/ssl/defectdojo/fullchain.pem;
    ssl_certificate_key /etc/ssl/defectdojo/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 100m;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
    }
}
