{
  "project": "defectdojo",
  "version": "3.4.202",
  "port": 8080,
  "site_url": "http://localhost:8080",
  "allowed_hosts": [
    "localhost",
    "127.0.0.1"
  ],
  "https": false,
  "backup_dir": "/srv/defectdojo/backups",
  "backup_copy_dir": "/mnt/dojo-backup/defectdojo",
  "retention_days": 14,
  "command_timeout": 300,
  "migration_timeout": 21600,
  "drain_timeout": 14400,
  "health_timeout": 600,
  "notification_hook": null,
  "profile": "single-vm-production",
  "worker_concurrency": 2,
  "uwsgi_processes": 2,
  "uwsgi_threads": 2,
  "postgres_settings": {
    "shared_buffers": "8GB",
    "effective_cache_size": "24GB",
    "work_mem": "8MB",
    "maintenance_work_mem": "512MB",
    "autovacuum_work_mem": "256MB",
    "max_connections": 80,
    "max_parallel_workers_per_gather": 0,
    "max_parallel_maintenance_workers": 2,
    "max_parallel_workers": 4,
    "max_worker_processes": 8,
    "autovacuum_max_workers": 3,
    "max_wal_size": "8GB",
    "min_wal_size": "2GB"
  },
  "resource_limits_gib": {
    "postgres": 20,
    "celeryworker": 12,
    "uwsgi": 8,
    "initializer": 8,
    "celerybeat": 1,
    "valkey": 2,
    "nginx": 1
  },
  "upload_max_mb": 800,
  "request_timeout": 3600,
  "upload_timeout": 300,
  "data_upload_max_memory_mb": 8,
  "backup_timeout": 21600,
  "restore_timeout": 43200,
  "data_mount": "/srv/defectdojo",
  "image_storage_dir": null,
  "backup_copy_mount": "/mnt/dojo-backup",
  "disk_reserve_gib": 50,
  "backup_estimate_gib": 50,
  "restore_estimate_gib": 200
}
