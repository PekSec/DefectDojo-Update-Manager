[Unit]
Description=DefectDojo verified daily backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=defectdojo-ops
Group=defectdojo-ops
SupplementaryGroups=docker
WorkingDirectory=/opt/defectdojo-update-manager
ExecStart=/opt/defectdojo-update-manager/dojo backup
UMask=0077
# Do not interrupt a drain, backup, or initializer with systemd's default deadline.
# Stage deadlines belong to config.json; systemd must not cut a long maintenance short.
TimeoutStartSec=infinity
TimeoutStopSec=infinity
Nice=10
StandardOutput=journal
StandardError=journal
